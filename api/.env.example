DATA_GO_KR_SERVICE_KEY=
# API 요청의 X-API-KEY 헤더와 비교할 값. 비어 있으면 API 서버가 기동하지 않는다.
API_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prop_trend

# 로깅. *_LOG_FILE을 주면 그 경로에 JSON 로그가 함께 쌓인다(로테이션 10MB × 5).
# 두 프로세스가 한 파일을 나눠 쓰지 않도록 API 서버와 배치 작업의 경로를 따로 둔다.
# 터미널 출력은 항상 사람이 읽는 형식이며, LOG_FORMAT=json으로 바꿀 수 있다.
# API_LOG_FILE=logs/api.log
# PIPELINE_LOG_FILE=logs/pipeline.log
# LOG_LEVEL=INFO

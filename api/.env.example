DATA_GO_KR_SERVICE_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prop_trend
# 갱신 API(/jobs/refresh) 인증키. openssl rand -hex 32 등으로 만들어 채운다.
# 비워두면 갱신 API가 503으로 잠긴다(예약 실행은 그대로 돈다).
REFRESH_API_KEY=

# 로깅. LOG_FILE을 주면 그 경로에 JSON 로그가 함께 쌓인다(로테이션 10MB × 5).
# 터미널 출력은 항상 사람이 읽는 형식이며, LOG_FORMAT=json으로 바꿀 수 있다.
# LOG_FILE=logs/pipeline.log
# LOG_LEVEL=INFO

# airflow/.env로 복사해 채운다. docker compose가 이 디렉터리의 .env를 변수 치환에 쓴다.

# Airflow 컴포넌트끼리 태스크 토큰을 검증하는 키. 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
# 메타 DB 비밀번호. 접속 URI에 그대로 들어가므로 URL에 안전한 문자만 쓴다(token_urlsafe 출력이면 된다).
# 볼륨을 처음 만들 때만 적용된다. 이미 만든 볼륨을 쓰면 그때의 값을 그대로 넣는다.
AIRFLOW_METADB_PASSWORD=
# 공공데이터포털 인증키. api/.env와 같은 값이다.
DATA_GO_KR_SERVICE_KEY=
# 태스크가 접속할 서비스 DB(Airflow Connection URI). 비우면 루트 스택의 postgres 서비스를 쓴다.
# PROP_TREND_DB_CONN=postgresql://postgres:postgres@postgres:5432/prop_trend

# airflow/.env로 복사해 채운다. docker compose가 이 디렉터리의 .env를 변수 치환에 쓴다.

# Airflow 컴포넌트끼리 태스크 토큰을 검증하는 키. 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
# 공공데이터포털 인증키. api/.env와 같은 값이다.
DATA_GO_KR_SERVICE_KEY=
# jobs 컨테이너가 접속할 서비스 DB. 비우면 루트 스택의 postgres 서비스를 쓴다.
# PROP_TREND_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/prop_trend
# 네이티브 태스크가 접속할 서비스 DB(Airflow Connection URI). 비우면 루트 스택의 postgres 서비스를 쓴다.
# PROP_TREND_DB_CONN=postgresql://postgres:postgres@postgres:5432/prop_trend
